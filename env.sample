# Environment Variables for Event Matcher App
# The actual file should be named .env.local

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Atlas Vector Search Index Names
EVENT_VECTOR_SEARCH_INDEX_NAME=event_vector_index
COURSE_VECTOR_SEARCH_INDEX_NAME=course_vector_index

## Admin Credentials (used by login form) and Session Secret
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change_me
ADMIN_SECRET=replace_with_strong_random_string


# --- Local development database (docker-compose-local.yml) ---
# To work against the local Docker database instead of production, use:
# MONGODB_URI="mongodb://localhost:27018/event-matcher?directConnection=true"
# MONGODB_LOCAL_PORT=27018   # host port used by docker-compose-local.yml
# Seed scripts refuse to run against a non-local MONGODB_URI unless ALLOW_REMOTE_DB=true
